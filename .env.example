# ==========================================================================
# Asistente de trámites FIIS - UNFV
# Copia este archivo como  .env  y ajusta los valores que necesites.
# En Windows (PowerShell):  Copy-Item .env.example .env
# ==========================================================================

# --- Ollama ---------------------------------------------------------------
# Dirección del servidor local de Ollama.
OLLAMA_HOST=http://localhost:11434
# Modelo de lenguaje a utilizar. Debe estar descargado: ollama pull qwen2.5:7b
OLLAMA_MODELO=qwen2.5:7b
# Temperatura de generación (0.0 = determinista, 1.0 = creativo).
OLLAMA_TEMPERATURA=0.2
# Segundos de espera máxima por respuesta del modelo.
OLLAMA_TIEMPO_ESPERA=120
# Tamaño de la ventana de contexto.
OLLAMA_NUM_CTX=8192
# Máximo de tokens que el modelo puede generar por respuesta. Si sale bajo, el JSON de
# extracción puede quedar truncado y descartarse; 1024 es holgado para este esquema.
OLLAMA_MAX_TOKENS=1024

# --- Rutas ----------------------------------------------------------------
# Rutas relativas a la raíz del proyecto o absolutas.
RUTA_PLANTILLA_FUT=assets/FUT_SG-FORMULARIO.pdf
RUTA_LOGO=assets/Logo_fiis_nuevo.png
RUTA_ESTILOS=assets/estilos.css
DIRECTORIO_SALIDAS=salidas

# --- Comportamiento -------------------------------------------------------
# Ciudad que se imprime en el campo "Lugar y Fecha".
CIUDAD_PREDETERMINADA=Lima
# Guardar una copia de cada FUT generado en DIRECTORIO_SALIDAS.
GUARDAR_COPIA_LOCAL=true
# Cuántos mensajes previos se envían al modelo en cada turno.
MENSAJES_EN_HISTORIAL=12
# Registros detallados en consola.
MODO_DEPURACION=false

# --- Identidad visual -----------------------------------------------------
COLOR_PRINCIPAL=#792D2F
NOMBRE_APLICACION=Asistente de trámites FIIS
